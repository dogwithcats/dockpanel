DOCKPANEL_PASSWORD=change-me-to-a-long-random-string
# Display name of the server the panel runs on
DOCKPANEL_HOST_LABEL=prod-web-01
# Sub-path when proxied as https://domain/dockerpanel/ (leave empty for domain root)
DOCKPANEL_BASE_PATH=
# Set to false to make the container file browser read-only
# ALLOW_FILE_WRITE=false
